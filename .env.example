# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: optional comma-separated list of multiple Gemini keys.
# When set, the server round-robins across them per session (and skips a
# key for 60s if it comes back rate-limited), spreading load across
# multiple Google accounts/projects. Takes priority over GEMINI_API_KEY.
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VANTAGE_AGENT_KEY: real Vantage agent API key (X-Agent-Key). Required for
# the real MCP connection to Vantage's live MCP server -- without it,
# mcp_server_client / tool_search_retrieval degrade to "no live connection"
# instead of touching real Vantage data.
VANTAGE_AGENT_KEY="vantage_..."

# VANTAGE_MCP_URL: Vantage's MCP endpoint. Defaults to the live production
# instance if unset.
VANTAGE_MCP_URL="https://omokoda.duckdns.org/mcp"

# VANTAGE_BASE_URL: Vantage's base API URL, used to reach the real
# /api/copilot/chat bridge for external agent frameworks (Hermes, OpenClaw).
VANTAGE_BASE_URL="https://omokoda.duckdns.org"

# HERMES_AGENT_KEY / OPENCLAW_AGENT_KEY: real X-Agent-Key values for
# Vantage's real Hermes (NousResearch/hermes-agent) and OpenClaw
# (openclaw/openclaw) agents. Server-side defaults used when the user
# doesn't override them in Settings > Agent & Model.
HERMES_AGENT_KEY=""
OPENCLAW_AGENT_KEY=""
