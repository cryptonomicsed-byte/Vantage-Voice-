# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: optional comma-separated list of multiple Gemini keys.
# When set, the server round-robins across them per session (and skips a
# key for 60s if it comes back rate-limited), spreading load across
# multiple Google accounts/projects. Takes priority over GEMINI_API_KEY.
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VANTAGE_AGENT_KEY: real Vantage agent API key (X-Agent-Key). Required for
# the real MCP connection to Vantage's live MCP server -- without it,
# mcp_server_client / tool_search_retrieval degrade to "no live connection"
# instead of touching real Vantage data.
VANTAGE_AGENT_KEY="vantage_..."

# VANTAGE_MCP_URL: Vantage's MCP endpoint. Defaults to the live production
# instance if unset.
VANTAGE_MCP_URL="https://omokoda.duckdns.org/mcp"

# VANTAGE_BASE_URL: Vantage's base API URL, used to reach the real
# /api/copilot/chat bridge for external agent frameworks (Hermes, OpenClaw).
VANTAGE_BASE_URL="https://omokoda.duckdns.org"

# HERMES_AGENT_KEY / HERMES_CONTABO_AGENT_KEY / OPENCLAW_AGENT_KEY: real
# X-Agent-Key values for Vantage's real Hermes instances (Hostinger and a
# second, separate one on Contabo -- own memory/session, same real
# DeepSeek + Vantage MCP wiring) and OpenClaw. Server-side defaults used
# when the user doesn't override them in Settings > Agent & Model.
HERMES_AGENT_KEY=""
HERMES_CONTABO_AGENT_KEY=""
OPENCLAW_AGENT_KEY=""

# HOSTINGER_TUNNEL_HOST / CONTABO_TUNNEL_HOST: WireGuard tunnel IPs used
# by src/lib/herdrSwarm.ts and the Contabo-based Hermes bridge.
HOSTINGER_TUNNEL_HOST="10.88.0.1"
CONTABO_TUNNEL_HOST="10.88.0.2"

# OWNER_VOICE_PIN: required to unlock the owner-control voice tools
# (list/set/remove API keys, change app settings, write to the secure
# memory tier). Never exposed to the model or the managed-key tools --
# it's the one thing the agent can never read or change about itself.
OWNER_VOICE_PIN=""

# COMPOSIO_API_KEY: powers the real OAuth connector hub (Gmail, GitHub,
# Outlook, Discord, Slack, GitLab, Notion, Dropbox). Get one free at
# composio.dev. Without it, /api/oauth/connections reports
# configured:false and the Connect buttons are disabled -- no fake
# connections are ever shown.
COMPOSIO_API_KEY=""

# COMPOSIO_USER_ID: stable Composio user id for this single-user app's
# connected accounts. Defaults to "vantage-voice-owner" if unset -- only
# change this if you want a fresh, separate set of connections.
COMPOSIO_USER_ID=""
